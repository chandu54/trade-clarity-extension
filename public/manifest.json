{
  "name": "TradeClarity.market",
  "description": "Professional swing trading research terminal. Organize watchlists weekly, quantify setups, Journaling and get AI insights.",
  "author": "TradeClarity Team",
  "version": "3.4.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://fc.yahoo.com/*",
    "https://finance.yahoo.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.niftyindices.com/*",
    "https://www.nseindia.com/*",
    "https://archives.nseindia.com/*",
    "https://api.nasdaq.com/*",
    "https://news.google.com/*",
    "https://chartink.com/*"
  ],
  "action": {
    "default_title": "Open TradeClarity.market",
    "default_icon": {
      "16": "app_logo.png",
      "32": "app_logo.png",
      "48": "app_logo.png",
      "128": "app_logo.png"
    }
  },
  "icons": {
    "16": "app_logo.png",
    "32": "app_logo.png",
    "48": "app_logo.png",
    "128": "app_logo.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/chart/*",
        "*://*.screener.in/*",
        "*://*.zerodha.com/*",
        "*://kite.zerodha.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://kite.zerodha.com/*"
      ],
      "js": [
        "zerodhaBridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "dashboard.html",
        "zerodhaBridge.js"
      ],
      "matches": [
        "*://*.tradingview.com/*",
        "*://*.screener.in/*",
        "*://*.zerodha.com/*",
        "*://kite.zerodha.com/*"
      ]
    }
  ]
}
