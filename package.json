{
  "name": "trade-clarity-market",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.content.config.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run --config vite.config.js",
    "test:watch": "vitest --config vite.config.js",
    "test:watchlist": "vitest run --config vite.config.js Watchlist",
    "test:journal": "vitest run --config vite.config.js Journal",
    "test:settings": "vitest run --config vite.config.js Settings",
    "test:utils": "vitest run --config vite.config.js utils",
    "test:e2e": "vitest run --config vite.config.js e2e",
    "update-metadata-db": "node scripts/generateMetadataDb.js"
  },
  "dependencies": {
    "lightweight-charts": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^5.0.0",
    "vitest": "^3.0.7"
  }
}
